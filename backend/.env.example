APP_NAME=SupportAI API
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000

# Format: postgresql+psycopg://USER:PASSWORD@localhost:5432/DATABASE_NAME
# If your password has special characters, URL-encode them (for example @ becomes %40)
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/support_ai

# Authentication (Day 4)
# Generate a key with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60